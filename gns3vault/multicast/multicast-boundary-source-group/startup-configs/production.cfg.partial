!
hostname production
!
!
!
ip multicast-routing
!
!
!
interface Loopback0
 no shutdown
 ip address 1.1.1.1 255.255.255.255
 ip pim sparse-mode
!
interface Ethernet0/1
 no shutdown
 ip address 192.168.12.1 255.255.255.0
 ip pim sparse-mode
!
!
!
router ospf 1
 network 0.0.0.0 255.255.255.255 area 0
!
!
!
!
!
!
!
!
!
!
!
!
!
!
!
!
line vty 0 4
 exec-timeout 0 0
 privilege level 15
 logging synchronous
 login local
 exec prompt timestamp
 transport input ssh
!
end