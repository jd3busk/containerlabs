!
hostname mrfreeze
!
!
!
!
!
!
!
interface Ethernet0/1
 no shutdown
 ip address 192.168.34.4 255.255.255.0
!
!
interface Ethernet0/2
 no shutdown
 ip address 192.168.45.4 255.255.255.0
!
!
!
!
!
!
!
!
!
!
!
!
!
line vty 0 4
 logging synchronous
 exec prompt timestamp
 exec-timeout 0 0
 privilege level 15
!
end