!
hostname spock
!
!
!
ip multicast-routing
!
!
!
interface Ethernet0/1
 no shutdown
 ip address 192.168.12.2 255.255.255.0
 ip pim dense-mode
!
interface Ethernet0/2
 no shutdown
 ip address 192.168.234.2 255.255.255.0
 ip pim dense-mode
!
!
!
router ospf 1
 router-id 2.2.2.2
 network 0.0.0.0 255.255.255.255 area 0
 distance 100 0.0.0.0 255.255.255.255 1
!
!
!
access-list 1 permit host 1.1.1.1
!
!
!
line vty 0 4
 logging synchronous
 exec prompt timestamp
 exec-timeout 0 0
 privilege level 15
!
end