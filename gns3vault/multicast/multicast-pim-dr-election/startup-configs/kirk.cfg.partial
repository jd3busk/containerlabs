!
hostname kirk
!
!
!
!
!
!
!
interface Ethernet0/1
 no shutdown
 ip address 192.168.13.3 255.255.255.0
!
!
interface Ethernet0/2
 no shutdown
 ip address 192.168.234.3 255.255.255.0
!
!
!
!
!
!
!
!
!
line vty 0 4
 logging synchronous
 exec prompt timestamp
 exec-timeout 0 0
 privilege level 15
!
end